{
  "name": "little-days-ios",
  "private": true,
  "version": "1.0.0",
  "description": "Native iOS app for Little Days (Capacitor). The web app is bundled locally; the backend stays on Supabase.",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && npx cap sync ios",
    "assets": "npx @capacitor/assets generate --ios --iconBackgroundColor '#FBF7F0' --splashBackgroundColor '#FBF7F0' --splashBackgroundColorDark '#1E1B2A'"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2",
    "@supabase/supabase-js": "2.119.2",
    "esbuild": "0.28.2"
  }
}
