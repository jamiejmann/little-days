# Little Days iOS: build + upload to TestFlight. Runs on GitHub Actions (macOS), started by hand.
# Signing: Xcode automatic signing with Apple's cloud-managed certificates, authorised by the
# App Store Connect API key (no certificates or passwords stored anywhere).
# Needs env: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8 (full .p8 text), APPLE_TEAM_ID
default_platform(:ios)

APP_ID  = "com.jamiejmann.littledays"
PROJECT = "ios/App/App.xcodeproj"

platform :ios do
  desc "Build Little Days and upload it to TestFlight"
  lane :beta do
    %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8 APPLE_TEAM_ID].each { |k| UI.user_error!("Missing #{k}") if ENV[k].to_s.strip.empty? }
    setup_ci # temporary keychain on the CI machine

    p8 = ENV["ASC_KEY_P8"].to_s.strip
    p8 = Base64.decode64(p8) unless p8.include?("BEGIN PRIVATE KEY") # accept raw .p8 text or base64 of it
    api_key = app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"].strip, issuer_id: ENV["ASC_ISSUER_ID"].strip, key_content: p8, duration: 1200, in_house: false)

    build_number = latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID, initial_build_number: 0) + 1
    UI.message("Building Little Days build #{build_number}")

    key_path = File.join(Dir.tmpdir, "AuthKey_#{ENV['ASC_KEY_ID'].strip}.p8")
    auth = "-allowProvisioningUpdates -authenticationKeyPath #{key_path} -authenticationKeyID #{ENV['ASC_KEY_ID'].strip} -authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID'].strip}"
    begin
      File.write(key_path, p8)
      build_app(
        project: PROJECT, scheme: "App", configuration: "Release", clean: true,
        export_method: "app-store", output_directory: "build", output_name: "LittleDays.ipa",
        xcargs: "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID'].strip} CODE_SIGN_STYLE=Automatic CURRENT_PROJECT_VERSION=#{build_number} #{auth}",
        export_xcargs: auth,
        export_options: { signingStyle: "automatic", teamID: ENV["APPLE_TEAM_ID"].strip, manageAppVersionAndBuildNumber: false }
      )
      upload_to_testflight(api_key: api_key, app_identifier: APP_ID, skip_waiting_for_build_processing: true)
    ensure
      File.delete(key_path) if File.exist?(key_path)
    end
  end
end
